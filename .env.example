APP_MODE=development
HOST=0.0.0.0
PORT=3001

# ----------------------------------------------------
# Host Motion Outputs (Shared Runtime Contract)
# These directories must match the 'target_dir' mapped
# in the native host Motion config (motion.conf / camera-*.conf)
# so the Dockerized orchestrator can read the clips locally.
# ----------------------------------------------------
CAMERA_1_DIR=./runtime/camera_1
CAMERA_2_DIR=./runtime/camera_2

# ----------------------------------------------------
# Internal Orchestrator Paths
# ----------------------------------------------------
PROCESSED_DIR=./runtime/processed
REJECTED_DIR=./runtime/rejected
DB_PATH=./runtime/db/orchestrator.sqlite
LOG_DIR=./runtime/logs

OPENCV_ENABLED=false
OPENCV_WORKER_COMMAND=
OPENCV_WORKER_ARGS=[]
OPENCV_WORKER_URL=
OPENCV_TIMEOUT_MS=30000

UPLOAD_ENABLED=false
UPLOAD_URL=
UPLOAD_HEADERS_JSON={}
UPLOAD_MAX_ATTEMPTS=3
UPLOAD_POLL_INTERVAL_MS=5000
UPLOAD_RETRY_DELAY_MS=30000
UPLOAD_TIMEOUT_MS=60000

IRRIGATION_ENABLED=false
IRRIGATION_TRIGGER_URL=
IRRIGATION_HEADERS_JSON={}
IRRIGATION_TIMEOUT_MS=10000